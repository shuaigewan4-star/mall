apiVersion: monitoring.coreos.com/v1alpha1
kind: AlertmanagerConfig
metadata:
  name: qqmail-alertmanager
  namespace: mall-prod
  labels:
    alertmanagerConfig: qqmail
spec:
  route:
    receiver: qqmail
    groupBy:
      - alertname
      - namespace
    groupWait: 30s
    groupInterval: 5m
    repeatInterval: 12h

  receivers:
    - name: qqmail
      emailConfigs:
        - to: "<YOUR_EMAIL>"
          from: "<YOUR_EMAIL>"
          smarthost: "smtp.qq.com:465"
          authUsername: "<YOUR_EMAIL>"
          authPassword:
            name: qqmail-smtp
            key: password
          requireTLS: true
